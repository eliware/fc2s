# Select `mysql` or `sqlite`.
DB_DRIVER=mysql

# Required only when DB_DRIVER=mysql
MYSQL_HOSTNAME=localhost
MYSQL_USERNAME=your_username
MYSQL_PASSWORD=your_password
# Optional: MYSQL_PORT=3306
# Optional: enable TLS with a CA bundle; chain and host-name verification are enforced.
# MYSQL_SSL_CA=/path/to/ca-chain.pem

# Both drivers write backend-specific tarballs under this directory.
# Optional: EXPORT_DIR=./exports
