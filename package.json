{
    "name": "@eliware/fc2s",
    "version": "1.0.4",
    "type": "module",
    "engines": {
        "node": ">=24.15.0"
    },
    "scripts": {
        "latest": "node examples/get_latest.mjs",
        "lint": "oxlint . --ignore-pattern node_modules",
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --coverage --detectOpenHandles --silent --runInBand"
    },
    "dependencies": {
        "adm-zip": "^0.6.1",
        "csv-parse": "^7.0.3",
        "dotenv": "^18.0.7",
        "mysql2": "^3.24.5"
    },
    "devDependencies": {
        "jest": "^30.5.2",
        "oxlint": "^1.87.0"
    },
    "jest": {
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [],
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs",
            "**/?(*.)+(spec|test).cjs"
        ]
    },
    "author": "Eli Sterling <eli@eliware.org>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/fc2s.git"
    },
    "bugs": {
        "url": "https://github.com/eliware/fc2s/issues"
    },
    "homepage": "https://github.com/eliware/fc2s#readme"
}
